# Counterfoil — environment configuration.
# Copy to `.env` at the repo root and fill in. `.env` is gitignored and must
# never be committed; variables already set in your shell take precedence.

# ---- AI (Google Gemini) ------------------------------------------------
# The key is read server-side only and sent in a request header — it never
# appears in a URL, a log, a template or a receipt. With no key the product
# runs whole on rules and the interface says so ("nothing here pretends").
CFOIL_AI_API_KEY=

# Models, chosen from the provider's live model list by measured capability
# (verified function calling, grounded tool round-trip, schema-constrained
# JSON, interactive latency). The fallback is tried once on 429/5xx.
CFOIL_AI_MODEL=gemini-2.5-flash
CFOIL_AI_MODEL_FALLBACK=gemini-3.5-flash-lite

# ---- Optional alternative provider (drafting only) ---------------------
# With only this key set, the intake acknowledgement is model-drafted but
# the tool-calling agent stays off (it is implemented for Gemini).
ANTHROPIC_API_KEY=
CFOIL_MODEL=claude-haiku-4-5

# ---- Signer ------------------------------------------------------------
# Shared secret for the signer's /sign endpoint. Optional on localhost
# demos; required in any shared environment (same value for both processes).
CFOIL_SIGNER_TOKEN=
