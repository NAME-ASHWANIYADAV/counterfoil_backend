{
  "format": "counterfoil.package/v1",
  "name": "exits",
  "version": "1.0.0",
  "service_line": "Employee exits",
  "description": "Resignation to full-and-final settlement: 19 steps, two reserved decisions (RSV-1 accept, RSV-6 final pay), statutory clocks closed only on confirmed evidence.",
  "steps": [
    {"id": "intake", "n": 1, "title": "Resignation intake; acknowledged, never accepted; case opened", "kind": "agent", "impl": "intake", "auto": false},
    {"id": "records", "n": 2, "title": "Record reconciliation: directory, assets, access card", "kind": "rule", "impl": "records_check", "auto": true, "depends_on": ["intake"]},
    {"id": "disclosure", "n": 3, "title": "Disclosure screen: POSH or grievance text sealed, route only (RSV-5)", "kind": "rule", "impl": "disclosure_screen", "auto": true, "depends_on": ["intake"]},
    {"id": "notice", "n": 4, "title": "Notice period, earliest last working day and buyout, by rule", "kind": "rule", "impl": "notice_calc", "auto": true, "depends_on": ["records"]},
    {"id": "pack", "n": 5, "title": "Approval pack; named approver resolved from the org chart", "kind": "rule", "impl": "approval_pack", "auto": true, "depends_on": ["notice", "disclosure"]},
    {"id": "accept", "n": 6, "title": "Accept the resignation; fix release date or notice buyout", "kind": "approval", "reserved": "RSV-1", "approver_role": "manager", "auto": false, "depends_on": ["pack"],
      "effect": {"action": "separation.accept", "target": "internal",
        "read_back": {"strategy": "none", "justification": "cfoil is the system of record for the separation decision"},
        "required_evidence": "internal", "retry_safe": true, "reversibility": "reversible"}},
    {"id": "confirm", "n": 7, "title": "Confirm to the employee; start the statutory clocks", "kind": "rule", "impl": "confirm_clocks", "auto": true, "depends_on": ["accept"]},
    {"id": "asset_ticket", "n": 8, "title": "Asset-return ticket with IT", "kind": "effect", "auto": true, "depends_on": ["accept"],
      "effect": {"action": "itsm.ticket.create", "target": "itsm", "path": "/itsm/tickets",
        "read_back": {"strategy": "attributed", "collection": "itsm/tickets"},
        "required_evidence": "attributed", "retry_safe": true, "reversibility": "compensable"}},
    {"id": "disable", "n": 9, "title": "Directory account disabled at the cut-off", "kind": "effect", "auto": true, "at": "lwd", "depends_on": ["accept"],
      "effect": {"action": "directory.disable", "target": "directory", "path": "/directory/disable",
        "read_back": {"strategy": "attributed", "collection": "directory/users"},
        "required_evidence": "observed", "retry_safe": true, "reversibility": "convergent"}},
    {"id": "revoke_card", "n": 10, "title": "Access card revoked at the cut-off", "kind": "effect", "auto": true, "at": "lwd", "depends_on": ["accept"],
      "effect": {"action": "cards.revoke", "target": "cards", "path": "/cards/revoke",
        "read_back": {"strategy": "attributed", "collection": "cards/cards"},
        "required_evidence": "observed", "retry_safe": true, "reversibility": "convergent"}},
    {"id": "handover", "n": 11, "title": "Handover confirmed by the manager", "kind": "human_input", "role": "manager", "auto": false, "depends_on": ["accept"]},
    {"id": "survey", "n": 12, "title": "Exit survey (optional)", "kind": "human_input", "role": "leaver", "auto": false, "optional": true, "depends_on": ["accept"]},
    {"id": "clearance", "n": 13, "title": "Last-day clearance re-checked against each system's own record", "kind": "rule", "impl": "clearance", "auto": true, "depends_on": ["disable", "revoke_card", "handover"]},
    {"id": "ff_compute", "n": 14, "title": "Full-and-final settlement computed by rules, every line cited", "kind": "rule", "impl": "ff_compute", "auto": true, "depends_on": ["clearance"]},
    {"id": "ff_stage", "n": 15, "title": "Settlement staged as a held draft, not payable", "kind": "effect", "auto": true, "depends_on": ["ff_compute"],
      "effect": {"action": "payroll.stage", "target": "payroll", "path": "/payroll/stage",
        "read_back": {"strategy": "attributed", "collection": "payroll/payments"},
        "required_evidence": "attributed", "retry_safe": true, "reversibility": "reversible"}},
    {"id": "ff_approve", "n": 16, "title": "Final pay signed off by the payroll approver and released under that mandate", "kind": "approval", "reserved": "RSV-6", "approver_role": "payroll", "auto": false, "depends_on": ["ff_stage"],
      "effect": {"action": "payroll.release", "target": "payroll", "path": "/payroll/payments",
        "read_back": {"strategy": "attributed", "collection": "payroll/payments"},
        "required_evidence": "attributed", "retry_safe": true, "reversibility": "irreversible"}},
    {"id": "letters", "n": 17, "title": "Relieving letter issued and receipted", "kind": "effect", "auto": true, "depends_on": ["ff_approve"],
      "effect": {"action": "document.issue", "target": "internal",
        "read_back": {"strategy": "none", "justification": "cfoil is the system of record for its own documents"},
        "required_evidence": "internal", "retry_safe": true, "reversibility": "reversible"}},
    {"id": "monitor", "n": 18, "title": "Deadline monitor: open clocks watched until each closes on evidence", "kind": "rule", "impl": "deadline_monitor", "auto": true, "depends_on": ["letters"]},
    {"id": "close", "n": 19, "title": "Case closed with its leaver-closure statement", "kind": "rule", "impl": "close_case", "auto": true, "depends_on": ["monitor"]}
  ]
}
