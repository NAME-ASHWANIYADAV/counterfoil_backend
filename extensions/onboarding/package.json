{
 "format": "counterfoil.package/v1",
 "name": "onboarding",
 "version": "1.0.0",
 "service_line": "Employee onboarding",
 "description": "Offer to day one on the same kernel: 16 steps, one reserved decision (RSV-2 extend offer). Ships inactive: a named HR administrator and a second person activate it after cfoil check passes \u2014 zero core files change.",
 "steps": [
  {
   "id": "intake",
   "n": 1,
   "title": "Candidate record opened from the signed offer",
   "kind": "agent",
   "impl": "intake",
   "auto": false
  },
  {
   "id": "records",
   "n": 2,
   "title": "Record checks: identity fields present, duplicates reconciled",
   "kind": "rule",
   "impl": "records_check",
   "auto": true,
   "depends_on": [
    "intake"
   ]
  },
  {
   "id": "offer",
   "n": 3,
   "title": "Offer extended by a named person",
   "kind": "approval",
   "reserved": "RSV-2",
   "approver_role": "hradmin",
   "auto": false,
   "depends_on": [
    "records"
   ]
  },
  {
   "id": "accept_track",
   "n": 4,
   "title": "Acceptance tracked; joining date confirmed",
   "kind": "rule",
   "impl": "approval_pack",
   "auto": true,
   "depends_on": [
    "offer"
   ]
  },
  {
   "id": "it_ticket",
   "n": 5,
   "title": "Laptop provisioning ticket with IT",
   "kind": "effect",
   "auto": true,
   "depends_on": [
    "accept_track"
   ],
   "effect": {
    "action": "itsm.ticket.create",
    "target": "itsm",
    "path": "/itsm/tickets",
    "read_back": {
     "strategy": "attributed",
     "collection": "itsm/tickets"
    },
    "required_evidence": "attributed",
    "retry_safe": true,
    "reversibility": "compensable"
   }
  },
  {
   "id": "card_issue",
   "n": 6,
   "title": "Access card prepared by Admin",
   "kind": "effect",
   "auto": true,
   "depends_on": [
    "accept_track"
   ],
   "effect": {
    "action": "itsm.ticket.create",
    "target": "itsm",
    "path": "/itsm/tickets",
    "read_back": {
     "strategy": "attributed",
     "collection": "itsm/tickets"
    },
    "required_evidence": "attributed",
    "retry_safe": true,
    "reversibility": "compensable"
   }
  },
  {
   "id": "payroll_setup",
   "n": 7,
   "title": "Payroll setup staged",
   "kind": "effect",
   "auto": true,
   "depends_on": [
    "accept_track"
   ],
   "effect": {
    "action": "payroll.stage",
    "target": "payroll",
    "path": "/payroll/stage",
    "read_back": {
     "strategy": "attributed",
     "collection": "payroll/payments"
    },
    "required_evidence": "attributed",
    "retry_safe": true,
    "reversibility": "reversible"
   }
  },
  {
   "id": "docs",
   "n": 8,
   "title": "Joining documents collected",
   "kind": "human_input",
   "role": "hrops",
   "auto": false,
   "depends_on": [
    "accept_track"
   ]
  },
  {
   "id": "buddy",
   "n": 9,
   "title": "Buddy and manager briefed",
   "kind": "rule",
   "impl": "approval_pack",
   "auto": true,
   "depends_on": [
    "accept_track"
   ]
  },
  {
   "id": "day1_check",
   "n": 10,
   "title": "Day-one readiness re-checked against each system's own record",
   "kind": "rule",
   "impl": "clearance",
   "auto": true,
   "depends_on": [
    "it_ticket",
    "card_issue"
   ]
  },
  {
   "id": "welcome",
   "n": 11,
   "title": "Welcome note and schedule issued",
   "kind": "effect",
   "auto": true,
   "depends_on": [
    "day1_check"
   ],
   "effect": {
    "action": "document.issue",
    "target": "internal",
    "read_back": {
     "strategy": "none",
     "justification": "cfoil is the system of record for its own documents"
    },
    "required_evidence": "internal",
    "retry_safe": true,
    "reversibility": "reversible"
   }
  },
  {
   "id": "probation_plan",
   "n": 12,
   "title": "Probation goals drafted for the manager",
   "kind": "rule",
   "impl": "approval_pack",
   "auto": true,
   "depends_on": [
    "accept_track"
   ]
  },
  {
   "id": "manager_confirm",
   "n": 13,
   "title": "Manager confirms the first-week plan",
   "kind": "human_input",
   "role": "manager",
   "auto": false,
   "depends_on": [
    "probation_plan"
   ]
  },
  {
   "id": "survey",
   "n": 14,
   "title": "Week-one check-in captured (optional)",
   "kind": "human_input",
   "role": "hrops",
   "auto": false,
   "optional": true,
   "depends_on": [
    "welcome"
   ]
  },
  {
   "id": "monitor",
   "n": 15,
   "title": "Readiness clocks watched until each closes",
   "kind": "rule",
   "impl": "deadline_monitor",
   "auto": true,
   "depends_on": [
    "welcome"
   ]
  },
  {
   "id": "close",
   "n": 16,
   "title": "Case closed with its closure statement",
   "kind": "rule",
   "impl": "close_case",
   "auto": true,
   "depends_on": [
    "monitor"
   ]
  }
 ]
}