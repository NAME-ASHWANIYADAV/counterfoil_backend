{{define "indoubt"}}{{template "head" .}}
<div class="topbar"><h1>In doubt</h1>
  <span class="crumb">when the outcome cannot be established, a named person looks at the target system — nothing is retried blindly</span></div>
<main id="main" data-live="1">{{template "indoubt-main" .}}</main>
{{template "foot" .}}{{end}}

{{define "indoubt-main"}}
{{$d := .Data}}
<div class="stack">
  <div class="card tight">
    <div class="hd"><h2>Open items</h2></div>
    <table class="t">
      <tr><th style="width:170px">Item</th><th>What the verifier saw</th><th style="width:360px">Resolve (you are accountable; receipted)</th></tr>
      {{range $d.Open}}
      <tr>
        <td><b>{{.ID}}</b><div class="note">case <a href="/cases/{{.CaseID}}">{{.CaseID}}</a> · step {{.StepID}}</div>
          <div class="note">owner: {{.OwnerRole}} · {{timefmt .Created}}</div></td>
        <td class="note">{{.Reason}}
          {{if .IntentKey}}<div>intent <span class="hash">{{short .IntentKey}}</span></div>{{end}}
          <div style="margin-top:6px">Look at the target's own records first: <a href="http://localhost:7072/" target="_blank">open the stand-in systems ↗</a></div></td>
        <td>
          <form method="post" action="/indoubt/{{.ID}}/resolve" class="stack" style="gap:8px">
            <input type="text" name="note" placeholder="what you saw in the target system" required>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <button class="btn sm" name="resolution" value="retry">Send again (safe only)</button>
              <button class="btn sm ghost" name="resolution" value="confirmed_done">I checked — it is done</button>
              <button class="btn sm ghost" name="resolution" value="cancelled">Cancel the step</button>
            </div>
          </form>
        </td>
      </tr>
      {{else}}<tr><td colspan="3" class="empty">Nothing is in doubt. That is the point.</td></tr>
      {{end}}
    </table>
  </div>

  <div class="card tight">
    <div class="hd"><h2>Resolved</h2></div>
    <table class="t">
      <tr><th>Item</th><th>Reason</th><th>Resolution</th><th style="width:150px">By</th></tr>
      {{range $d.Closed}}
      <tr><td><b>{{.ID}}</b><div class="note">{{.CaseID}} · {{.StepID}}</div></td>
        <td class="note">{{.Reason}}</td>
        <td><span class="pill p-done">{{.Resolution}}</span></td>
        <td class="note">{{.ResolvedBy}} · {{timefmt .Resolved}}</td></tr>
      {{else}}<tr><td colspan="4" class="empty">—</td></tr>
      {{end}}
    </table>
  </div>
</div>
{{end}}
